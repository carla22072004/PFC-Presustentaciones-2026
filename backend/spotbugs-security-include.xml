<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtro de SpotBugs + find-sec-bugs: limita el analisis a la categoria SECURITY
  (incluye SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE para deteccion de SQL dinamico/inyeccion).
  Se usa con `mvn com.github.spotbugs:spotbugs-maven-plugin:check` en el pipeline de CI.
-->
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">
    <Match>
        <Bug category="SECURITY"/>
    </Match>
</FindBugsFilter>
