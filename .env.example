# =========================================================================
# Plantilla de Variables de Entorno para Docker Compose y Servidor
# Copie este archivo a un archivo llamado .env en el mismo directorio.
# Modifique los valores para su entorno de desarrollo local.
# =========================================================================

# Credenciales de Base de Datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgresAdminPassword

# Configuración de Seguridad y JWT
# Genere una clave de 256 bits (64 caracteres hexadecimales) para producción
JWT_SECRET=generar_clave_hexadecimal_aleatoria_de_64_caracteres
JWT_EXPIRATION=3600000
# Vigencia del token de renovacion, en milisegundos (por omision: 604800000 = 7 dias)
JWT_REFRESH_EXPIRATION=604800000

# RNF-15: cuenta ADMIN inicial para un despliegue real (SPRING_PROFILES_ACTIVE != dev).
# Obligatorias si todavia no existe ningun usuario ADMIN en la base: sin ellas, el backend
# falla al arrancar en vez de sembrar una cuenta con contrasena conocida (ver AdminBootstrap).
# La contrasena debe cumplir la politica de RNF-06 (minimo 8 caracteres, no estar en
# backend/src/main/resources/security/common-passwords.txt).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
