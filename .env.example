# =========================================================================
# Plantilla de Variables de Entorno para Docker Compose y Servidor
# Copie este archivo a un archivo llamado .env en el mismo directorio.
# Modifique los valores para su entorno de desarrollo local.
# =========================================================================

# Credenciales de Base de Datos PostgreSQL
DB_USERNAME=postgres
DB_PASSWORD=postgresAdminPassword

# Configuración de Seguridad y JWT
# Genere una clave de 256 bits (64 caracteres hexadecimales) para producción
JWT_SECRET=generar_clave_hexadecimal_aleatoria_de_64_caracteres
JWT_EXPIRATION=3600000
